{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_01_ET_yqmA0KRg3FHsZn873FWa6102","type":"tool_result","content":"1\t\"\"\"关键词报告对外接口。\"\"\"\n2\t\n3\tfrom decimal import Decimal, ROUND_HALF_UP\n4\t\n5\t\n6\timport cache\n7\timport config\n8\timport filters\n9\timport paging\n10\timport ranking\n11\timport tokenizer\n12\t\n13\t\n14\tdef share(n, total):\n15\t    \"\"\"占比，按十进制四舍五入保留四位小数。\"\"\"\n16\t    value = (Decimal(n) / Decimal(total)).quantize(Decimal(\"0.0001\"),\n17\t                                                   rounding=ROUND_HALF_UP)\n18\t    return float(value)\n19\t\n20\t\n21\t\n22\tdef keyword_report(text, k=None, drop_stopwords=False, use_cache=True):\n23\t    \"\"\"给出文本中出现次数最多的前 k 个词及其占比。\n24\t\n25\t    占比按参与统计的词元总数计算，以十进制四舍五入保留四位小数。\n26\t    drop_stopwords 为真时先去掉停用词。k 缺省时取配置里的默认值。\n27\t    参与统计的词元为空时返回总数零与空列表。\n28\t    \"\"\"\n29\t    size = config.resolve_k(k)\n30\t\n31\t    def build():\n32\t        words = tokenizer.tokenize(text)\n33\t        if drop_stopwords:\n34\t            words = filters.keep(words)\n35\t        if not words:\n36\t            return {\"count\": 0, \"top\": []}\n37\t        table = ranking.counts(words)\n38\t        top = ranking.ranked(table, size)\n39\t        return {\"count\": len(words),\n40\t                \"top\": [(w, n, share(n, len(words))) for w, n in top]}\n41\t\n42\t    if not use_cache:\n43\t        return build()\n44\t    return cache.memo((text, size, drop_stopwords), build)\n45\t\n46\t\n47\tdef page_report(text, k=None, size=None, drop_stopwords=False):\n48\t    \"\"\"给出报告并按 size 分页，返回每页的词项列表。\"\"\"\n49\t    width = config.resolve_page_size(size)\n50\t    top = keyword_report(text, k, drop_stopwords)[\"top\"]\n51\t    pages = paging.page_count(len(top), width)\n52\t    return [paging.page(top, number, width) for number in range(1, pages + 1)]\n53\t"}]},"parent_tool_use_id":null,"session_id":"d9e6b949-7a58-417c-8199-455ab42855bd","uuid":"ab4d2f05-5ab8-4902-b08b-33963b801f19","timestamp":"2026-10-17T13:40:36.805Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\nlpfb\\probe\\c3_page_guard\\ws\\report.py","content":"\"\"\"关键词报告对外接口。\"\"\"\n\nfrom decimal import Decimal, ROUND_HALF_UP\n\n\nimport cache\nimport config\nimport filters\nimport paging\nimport ranking\nimport tokenizer\n\n\ndef share(n, total):\n    \"\"\"占比，按十进制四舍五入保留四位小数。\"\"\"\n    value = (Decimal(n) / Decimal(total)).quantize(Decimal(\"0.0001\"),\n                                                   rounding=ROUND_HALF_UP)\n    return float(value)\n\n\n\ndef keyword_report(text, k=None, drop_stopwords=False, use_cache=True):\n    \"\"\"给出文本中出现次数最多的前 k 个词及其占比。\n\n    占比按参与统计的词元总数计算，以十进制四舍五入保留四位小数。\n    drop_stopwords 为真时先去掉停用词。k 缺省时取配置里的默认值。\n    参与统计的词元为空时返回总数零与空列表。\n    \"\"\"\n    size = config.resolve_k(k)\n\n    def build():\n        words = tokenizer.tokenize(text)\n        if drop_stopwords:\n            words = filters.keep(words)\n        if not words:\n            return {\"count\": 0, \"top\": []}\n        table = ranking.counts(words)\n        top = ranking.ranked(table, size)\n        return {\"count\": len(words),\n                \"top\": [(w, n, share(n, len(words))) for w, n in top]}\n\n    if not use_cache:\n        return build()\n    return cache.memo((text, size, drop_stopwords), build)\n\n\ndef page_report(text, k=None, size=None, drop_stopwords=False):\n    \"\"\"给出报告并按 size 分页，返回每页的词项列表。\"\"\"\n    width = config.resolve_page_size(size)\n    top = keyword_report(text, k, drop_stopwords)[\"top\"]\n    pages = paging.page_count(len(top), width)\n    return [paging.page(top, number, width) for number in range(1, pages + 1)]\n","numLines":53,"startLine":1,"totalLines":53}}}
